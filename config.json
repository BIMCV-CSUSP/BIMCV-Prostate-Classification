{
    "name": "Prostate_BIMCV_noDerivatives",
    "description": "With new Fold 4 Picai weights no Derivatives",
    "task": "classification",
    "n_gpu": 1,
    "seed": 42,
    "arch": {
        "module": "models",
        "type": "EfficientNet_pretrained",
        "args": {
            "model_name": "efficientnet-b7",
            "n_classes": 2,
            "in_channels_eff": 3,
            "pretrained_weights_path": "/home/ceib/jaalzate/BIMCV-Prostate-Classification/logs/classification/Prostate_Picai_efficientnetb7/18-Aug-2025-10:41:51/models/Fold 4/best-model-weights.pth" 
        }
    },
    "data_loader": {
        "module": "Dataloader",
        "type": "Dataloader",
        "partitions": {
            "train": "train",
            "val": "val",
            "test": "test"
        },
        "args": {
            "path": "./Files/data_noder.csv",
            "test_run": false,
            "partition_column": "split",
            "config": {
                "batch_size": 32,
                "drop_last": true,
                "shuffle": true
            }
        }
    },
    "optimizer": {
        "type": "Adadelta",
        "args": {
            "lr": 1.0,
            "rho": 0.95,
            "eps": 1e-07
        }
    },
    "loss": {
        "module": "torch.nn",
        "type": "CrossEntropyLoss",
        "args": {}
    },
    "metrics": {
        "accuracy": {
            "module": "torchmetrics.functional.classification",
            "type": "accuracy",
            "args": {
                "task": "multiclass",
                "average": "weighted",
                "num_classes": 2
            }
        },
        "f1": {
            "module": "torchmetrics.functional",
            "type": "f1_score",
            "args": {
                "task": "multiclass",
                "average": "weighted",
                "num_classes": 2
            }
        }
    },
    "trainer": {
        "type": "ClassificationTrainer",
        "epochs": 200,
        "save_dir": "/home/ceib/jaalzate/BIMCV-Prostate-Classification/logs",
        "save_period": 33,
        "verbosity": 2,
        "monitor": "max val_f1",
        "early_stop": 200,
        "tensorboard": true
    }
}